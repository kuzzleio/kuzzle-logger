{
  "name": "kuzzle-logger",
  "version": "1.5.0",
  "description": "Logger package for Kuzzle backend, JS SDK, and any related module (like gateways).",
  "author": "The Kuzzle Team <support@kuzzle.io>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kuzzleio/kuzzle-logger",
  "bugs": "https://github.com/kuzzleio/kuzzle-logger/issues",
  "repository": "github:kuzzleio/kuzzle-logger",
  "keywords": [
    "kuzzle"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/esm/browser/index.d.ts",
      "default": "./dist/esm/browser/index.js"
    },
    "./kuzzle": {
      "types": "./dist/kuzzle/index.d.ts",
      "default": "./dist/kuzzle/index.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "dist/esm/browser/index.d.ts"
      ],
      "kuzzle": [
        "dist/kuzzle/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:lint && npm run test:functional",
    "test:functional": "vitest run",
    "test:types": "tsc -b tsconfig.build.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test:lint": "eslint .",
    "test:lint:fix": "eslint . --fix",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc --build tsconfig.build.json && tsc -p tsconfig.browser.json && node scripts/write-esm-package.mjs",
    "prepack": "npm run build",
    "test:smoke": "node test/smoke/run.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^22.13.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.19.0",
    "eslint-plugin-kuzzle": "^1.0.0-eslint-9.6",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "kuzzle-sdk": "^7.14.0",
    "lint-staged": "^15.4.3",
    "pino-elasticsearch": "*",
    "pino-loki": "^2.5.0",
    "pino-pretty": "*",
    "pino-transport-ecs": "*",
    "rimraf": "^6.0.1",
    "semantic-release": "25.0.3",
    "semantic-release-config-kuzzle": "1.7.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "pino": "^9.6.0"
  },
  "peerDependencies": {
    "pino-elasticsearch": "^8.1.0",
    "pino-loki": "^2.5.0",
    "pino-pretty": "^13.0.0",
    "pino-transport-ecs": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "pino-elasticsearch": {
      "optional": true
    },
    "pino-loki": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "pino-transport-ecs": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ]
}
